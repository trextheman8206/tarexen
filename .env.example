# Copia este archivo a .env.local y completa los valores. NUNCA subas .env.local a git.

# --- Sitio público ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Número de WhatsApp con código de país, solo dígitos (ej.: 593991234567). Vacío = botón oculto.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Email público de contacto. Vacío = no se muestra.
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Panel de administración ---
ADMIN_PASSWORD=
# 32+ caracteres aleatorios. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# --- Base de datos ---
# Vacío = archivo local data/tarexen.db. En producción (gratis): Turso.
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# --- Avisos por email de solicitudes nuevas (Resend, plan gratis) ---
# Vacío = no se envían avisos; las solicitudes se ven solo en el panel.
# Con el remitente de pruebas, la cuenta de Resend debe usar el mismo email que recibe los avisos.
RESEND_API_KEY=
# Opcional: por defecto se usa el email público de contacto.
NOTIFY_EMAIL=

# --- Integraciones de IA (Fase E; hoy NO se usan: todo es manual) ---
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_PLACES_API_KEY=
